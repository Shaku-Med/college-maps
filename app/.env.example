# Copy to .env.development (read by next dev) and .env.production (read by next build).
# The Go API origin from backend/bkapp. Leave empty to run the map without accounts.
# Local: http://localhost:8080. Production: the Render API; the site proxies /v1 to it.
NEXT_PUBLIC_API_URL=http://localhost:8080
# The realtime server from backend/rtapp, used for live meetup locations.
NEXT_PUBLIC_REALTIME_URL=http://localhost:8090
