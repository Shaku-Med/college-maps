# Copy to .env.development (read by next dev) and .env.production (read by next build).
# Origin the browser calls for accounts. Leave empty to run the map without accounts.
# Local: the Go API. Production: this website; netlify.toml proxies /v1 to Render.
NEXT_PUBLIC_API_URL=http://localhost:8080
# The realtime server from backend/rtapp, used for live meetup locations.
NEXT_PUBLIC_REALTIME_URL=http://localhost:8090
