# Copy to .env.development and .env.production. The server loads the one matching APP_ENV
# (development when APP_ENV is unset). Both real files stay out of git.
PORT=8080
# development or production
APP_ENV=development
# Comma separated web origins that may call the API with cookies. http://localhost is only allowed in development.
ALLOWED_ORIGINS=http://localhost:3000
# Neon connection string. Use sslmode=verify-full (checks the certificate) and drop channel_binding, which the Go driver ignores.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=
# smtp sends through a mail account over an SMTP port, gmail sends through a Gmail account over https
# (use this on hosts that block SMTP), resend uses resend.com, log prints codes to the console
# (development only).
EMAIL_MODE=log
# Only for EMAIL_MODE=smtp. Gmail: turn on 2-Step Verification, create an app password at
# myaccount.google.com/apppasswords, and use it here. Many hosts, including Render's free plan,
# block outbound SMTP ports; there smtp mode times out and you want gmail mode below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourapp@gmail.com
SMTP_PASSWORD=
# Only for EMAIL_MODE=gmail. Same Gmail account, but over https so blocked SMTP ports do not matter.
# Create a Desktop app OAuth client in the Google Cloud console, then run:
#   go run ./cmd/gmailtoken -id <client id> -secret <client secret>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Only for EMAIL_MODE=resend.
RESEND_API_KEY=
# With Gmail this must be the same account as SMTP_USERNAME or the account that signed in above.
EMAIL_FROM=CSI Map <yourapp@gmail.com>
# Optional. Only a header the host overwrites, never a client-supplied one.
# Render: X-Forwarded-For (the server uses the last comma-separated IP).
CLIENT_IP_HEADER=
# Shared with rtapp. Must match rtapp's TICKET_SECRET.
TICKET_SECRET=
# Web Push keys are written to .env.notification on first start. If that file exists it is left
# as-is; empty or invalid values keep notifications off.
