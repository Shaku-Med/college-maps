# Copy to .env.development and .env.production. The server loads the one matching APP_ENV
# (development when APP_ENV is unset). Both real files stay out of git.
PORT=8090
# development or production
APP_ENV=development
# Comma separated web origins allowed to open streams and send positions.
ALLOWED_ORIGINS=http://localhost:3000
# Shared with bkapp, which signs the tickets. At least 32 random characters, different from AUTH_SECRET.
TICKET_SECRET=
# Optional. Only set this to a header your host writes itself, like Fly-Client-IP.
CLIENT_IP_HEADER=
