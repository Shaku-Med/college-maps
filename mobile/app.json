{
  "expo": {
    "name": "CSI Map",
    "slug": "csi-map",
    "owner": "meddi",
    "version": "1.3.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "csimap",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/eceb1ff3-a4e6-4523-b073-e4883202be26"
    },
    "ios": {
      "bundleIdentifier": "com.shakumed.csimap",
      "appleTeamId": "5VH593K857",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "CSI Map",
        "NSSupportsLiveActivities": true,
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.shakumed.csimap",
      "adaptiveIcon": {
        "backgroundColor": "#1268D2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1268D2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CSI Map shows where you are on campus and guides you turn by turn to buildings and rooms, including while your screen is locked during directions.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "CSI Map uses your location to guide you turn by turn to buildings and rooms, including while your screen is locked during directions."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-updates",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.shakumed.csimap",
          "widgets": [
            {
              "name": "UpNext",
              "displayName": "Up Next",
              "description": "Your next class or the meetup you're in.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Up Next",
                  "description": "Choose what the widget shows.",
                  "parameters": {
                    "show": {
                      "title": "Show",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Classes and meetups",
                          "value": "all"
                        },
                        {
                          "name": "Classes only",
                          "value": "classes"
                        },
                        {
                          "name": "Meetups only",
                          "value": "meetups"
                        }
                      ],
                      "default": "all"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1268D2"
        }
      ],
      "expo-quick-actions",
      "./plugins/with-background-modes"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eceb1ff3-a4e6-4523-b073-e4883202be26"
      }
    }
  }
}
